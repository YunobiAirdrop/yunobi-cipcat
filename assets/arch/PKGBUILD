# Maintainer: noxygalaxy <noxycraftyt@gmail.com>
pkgname=yunobi-cipcat
pkgver=${CONCAT_VERSION:?CONCAT_VERSION must be set}
pkgrel=1
pkgdesc="Free and open source video editor"
arch=('x86_64' 'aarch64')
url="https://github.com/jub0t/concat"
license=('AGPL-3.0-or-later')
depends=('glibc' 'gtk3' 'fontconfig' 'freetype2' 'libxkbcommon' 'mesa' 'alsa-lib')
options=('!strip' '!debug')
source=()

stage=${CONCAT_STAGE:?CONCAT_STAGE must point at the staged folder}

package() {
  install -Dm755 "$stage/yunobi-cipcat" "$pkgdir/opt/yunobi-cipcat/yunobi-cipcat"
  install -d "$pkgdir/opt/yunobi-cipcat/lib"
  cp -a "$stage"/lib/. "$pkgdir/opt/yunobi-cipcat/lib/"

  install -d "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /opt/yunobi-cipcat/yunobi-cipcat "$@"\n' > "$pkgdir/usr/bin/yunobi-cipcat"
  chmod 755 "$pkgdir/usr/bin/yunobi-cipcat"
  install -Dm644 "$stage/yunobi-cipcat.desktop" "$pkgdir/usr/share/applications/yunobi-cipcat.desktop"
  sed -i 's|^Exec=yunobi-cipcat|Exec=/opt/yunobi-cipcat/yunobi-cipcat %U|' "$pkgdir/usr/share/applications/yunobi-cipcat.desktop"
  install -Dm644 "$stage/yunobi-cipcat.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/yunobi-cipcat.png"

  install -Dm644 "$stage/LICENSE" "$pkgdir/usr/share/licenses/yunobi-cipcat/LICENSE"
  install -Dm644 "$stage/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/yunobi-cipcat/THIRD_PARTY_NOTICES.md"
}
